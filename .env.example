# Copy to .env.local for local development. Never commit real secrets.

# Public site URL (used for canonical links, sitemap, robots and social images).
# On Vercel this falls back to your production domain automatically, so it is optional there.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Contact form delivery ────────────────────────────────────
# Nothing below is read until you enable an option in lib/contact-delivery.ts.

# Option A: Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# CONTACT_TO_EMAIL=you@your-domain.com
# CONTACT_FROM_EMAIL="AvoSync <hello@your-domain.com>"

# Option B: Formspree (https://formspree.io)
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
